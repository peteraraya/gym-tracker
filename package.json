{
  "name": "gym-tracker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "check:images": "node scripts/check-images.js",
    "generate:placeholders": "node scripts/generate-placeholders.js && node scripts/zip-placeholders.js",
    "generate:icons": "node scripts/generate-icons.js",
    "generate:favicon": "node scripts/generate-favicon-ico.js",
    "test": "jest --watch",
    "test:ci": "jest --ci --coverage",
    "test:unit": "jest --testPathPattern=__tests__/unit",
    "test:integration": "jest --testPathPattern=__tests__/integration",
    "test:e2e": "jest --testPathPattern=__tests__/e2e",
    "test:coverage": "jest --coverage --watchAll=false",
    "build:mobile": "cp next.config.mobile.ts next.config.ts && next build && git checkout next.config.ts",
    "cap:init": "cap init gym-tracker com.gymtracker.app",
    "cap:add:android": "cap add android",
    "cap:sync": "cap sync",
    "cap:open:android": "cap open android",
    "mobile:build": "npm run build:mobile && cap sync",
    "mobile:open": "cap open android",
    "vercel:deploy": "npx vercel --prod",
    "analyze": "cross-env ANALYZE=true next build"
  },
  "dependencies": {
    "@capacitor/app": "^6.0.1",
    "@capacitor/core": "^6.2.0",
    "@hookform/resolvers": "^5.2.2",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.86.0",
    "@tanstack/react-query": "^5.95.2",
    "@tanstack/react-query-devtools": "^5.95.2",
    "@tanstack/react-virtual": "^3.13.23",
    "framer-motion": "^12.34.3",
    "lucide-react": "^0.555.0",
    "next": "^16.1.4",
    "next-intl": "^4.5.6",
    "phosphor-react": "^1.4.1",
    "puppeteer": "^24.15.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-hook-form": "^7.74.0",
    "web-push": "^3.6.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.5",
    "@fast-check/jest": "^2.2.0",
    "@next/bundle-analyzer": "^16.1.6",
    "@playwright/test": "^1.44.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.3",
    "babel-plugin-react-compiler": "1.0.0",
    "cross-env": "^7.0.3",
    "eslint": "^9",
    "eslint-config-next": "^16.1.4",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "sharp": "^0.33.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
